# NextGen Farmers Hub - Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_DATABASE=nextgen_db
MYSQL_USER=nextgen_user
MYSQL_PASSWORD=your_strong_password_here

# ERPNext Configuration
SITE_NAME=nextgenfarmershub.com
ADMIN_PASSWORD=your_admin_password_here
FRAPPE_VERSION=version-14
ERPNEXT_VERSION=version-14

# Auto Migration
AUTO_MIGRATE=1

# Redis Configuration (default values, usually no need to change)
REDIS_CACHE=redis://redis-cache:6379
REDIS_QUEUE=redis://redis-queue:6379
REDIS_SOCKETIO=redis://redis-queue:6379

# Monitoring (optional)
GRAFANA_PASSWORD=admin

# Email Configuration (optional - configure after installation)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_LOGIN=noreply@nextgenfarmershub.com
MAIL_PASSWORD=your_email_password

# Backup Configuration
MAX_BACKUPS=7
BACKUP_CRON_TIME="0 2 * * *"

# AWS Configuration (for deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Domain Configuration
DOMAIN=nextgenfarmershub.com
LETSENCRYPT_EMAIL=admin@nextgenfarmershub.com
