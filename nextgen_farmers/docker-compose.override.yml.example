# Docker Compose Override Example
# Copy this file to docker-compose.override.yml for local development customizations
# This file is gitignored and won't be committed

version: "3.8"

services:
  # Development overrides
  erpnext-backend:
    environment:
      - DEVELOPER_MODE=1
    volumes:
      # Mount local app for development
      - ./nextgen_farmers:/home/frappe/frappe-bench/apps/nextgen_farmers
    ports:
      - "8000:8000"  # Expose backend directly for debugging

  # Expose database for local access
  mariadb:
    ports:
      - "3306:3306"

  # Expose redis for debugging
  redis-cache:
    ports:
      - "6379:6379"

  # Enable monitoring by default in development
  prometheus:
    profiles: []  # Remove monitoring profile requirement

  grafana:
    profiles: []  # Remove monitoring profile requirement
